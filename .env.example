# Справочник: какие ключи нужны заводу. Сами ключи — в ~/.claude/.env (install.py дописывает туда пустые строки).
# Сюда ключи не вставлять. Старый .env в папке завода тоже читается, но только как запасной.
KIE_API_KEY=          # креативные ролики: kie.ai → API Key (оплата по факту, 1 кредит ≈ $0,005)
BUFFER_API_KEY=       # выкладка: publish.buffer.com/settings/api → Personal Access → New Key
APIFY_TOKEN=          # конкуренты, сбор чужих рилсов: console.apify.com → Settings → API (бесплатно $5 в месяц)
GEMINI_API_KEY=       # расшифровка кыргызского и разбор видео: aistudio.google.com/apikey (бесплатно)
ELEVENLABS_API_KEY=   # голос без лица: elevenlabs.io/app/settings/api-keys
HEYGEN_API_KEY=       # аватар по API (обычно не нужен: коннектор HeyGen в claude.ai)
TELEGRAM_BOT_TOKEN=   # Telegram-бот: @BotFather → /newbot (модули/бот.md)
